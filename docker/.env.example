# Copy to docker/.env and adjust. Values below are examples, not defaults.

# Owner of the Herdr socket: run `id -u` and `id -g` as the user running Herdr.
HERDR_UID=1000
HERDR_GID=1000

# Directory that contains herdr.sock. Usually ~/.config/herdr; from inside a
# Herdr pane, `dirname "$HERDR_SOCKET_PATH"` prints it.
HERDR_SOCKET_DIR=/home/you/.config/herdr

# Absolute path of the host's herdr binary: `command -v herdr`
HERDR_BINARY=/home/you/.local/bin/herdr

# Loopback port on the host.
HERDR_MCP_HOST_PORT=8765

# Policy (optional, see README "Configuration").
HERDR_MCP_DEFAULT_KIND=
HERDR_MCP_CWD_ALLOW=
HERDR_MCP_ALLOW=
HERDR_MCP_AGENT_KINDS=
HERDR_MCP_READ_ONLY=
HERDR_MCP_DISABLE_TOOLS=
