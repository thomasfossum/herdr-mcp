#!/usr/bin/env python3
"""herdr-mcp entry point. Adds the bundled src/ to the path and dispatches."""

import os
import sys

_HERE = os.path.dirname(os.path.abspath(__file__))
sys.path.insert(0, os.path.join(os.path.dirname(_HERE), "src"))

from herdr_mcp.server import main  # noqa: E402

if __name__ == "__main__":
    raise SystemExit(main())